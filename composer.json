{
    "name": "stackway/core",
    "description": "Stackway - Personal Laravel Framework with Dashboard, Module Generator & Clean Architecture",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Stackway Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/console": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/view": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Stackway\\Core\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Stackway\\Core\\StackwayServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
