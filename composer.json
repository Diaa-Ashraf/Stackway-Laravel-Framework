{
    "name": "stackway/core",
    "description": "Stackway - Personal Laravel Framework with Dashboard, Module Generator & Clean Architecture",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Stackway Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-translatable": "^6.8",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.16"
    },
    "autoload": {
        "psr-4": {
            "Stackway\\Core\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Stackway\\Core\\StackwayServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
